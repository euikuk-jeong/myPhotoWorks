<?xml version="1.0" encoding="utf-8"?>
<ConversionProfile application="FUJIFILM X RAW STUDIO" version="1.0.0">
  <PropertyGroup label="Astia / Soft" version="1.0.0">
    <FilmSimulation>Astia</FilmSimulation>
    <GrainEffect>OFF</GrainEffect>
    <GrainEffectSize>SMALL</GrainEffectSize>
    <WhiteBalance>Kelvin</WhiteBalance>
    <Kelvin>5600</Kelvin>
    <WhiteBalanceShiftR>0</WhiteBalanceShiftR>
    <WhiteBalanceShiftB>0</WhiteBalanceShiftB>
    <HighlightTone>-1</HighlightTone>
    <ShadowTone>-1</ShadowTone>
    <Color>-1</Color>
    <Sharpness>0</Sharpness>
    <NoiseReduction>0</NoiseReduction>
    <Clarity>0</Clarity>
  </PropertyGroup>
</ConversionProfile>
